# Porta da API
PORT=3001

# Origem do frontend (CORS). Separe várias por vírgula.
FRONTEND_URL=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publica
# NUNCA exponha esta chave no frontend: ela ignora RLS e é usada só para gravar o catálogo.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# TMDB → https://www.themoviedb.org/settings/api → "API Read Access Token" (v4, usado como Bearer na API v3)
TMDB_READ_TOKEN=seu-token-de-leitura-tmdb

# Cache em memória das respostas do TMDB (segundos)
TMDB_CACHE_TTL=600
